<div class="h-screen text-primary-dark bg-cover bg-top flex flex-col"
     style="background-image: url('<%= asset_path("rsvp-hero.jpg") %>')">

  <%= render "shared/navbar" %>

  <div class="flex-1 flex items-center justify-center">
    <%= image_tag "deadline.png", class: "md:w-1/3 w-5/6" %>
  </div>

</div>
<div class="bg-secondary-dark flex justify-center align-center font-minion">
    <%= form_with model: @rsvp, class:"bg-accent w-1/2 my-16 p-16 text-secondary-dark" do |f| %>
        <div class="mb-8">
            <h5 class="font-eddie font-normal">Email</h5>
            <%= f.email_field :email, class:"border border-3 text-3xl p-4 w-full" %>
        </div>

        <div class="mb-8"> 
            <h5 class="font-eddie font-normal">Will you be attending?</h5>
            <div class="flex gap-4 flex-col text-3xl" >
                <label class="flex align-center gap-4">
                    <%= f.radio_button :attending, true, class:"accent-secondary-dark w-8 h-8" %>
                    Yes
                </label>

                <label class="flex align-center gap-4">
                    <%= f.radio_button :attending, false, class:"accent-secondary-dark w-8 h-8" %>
                    No
                </label>
            </div>
        </div>

        <div class="mb-8">
            <h5 class="font-eddie font-normal">Which events will you be attending?</h5>
            <div class="flex gap-4 flex-col text-3xl">
                <label class="flex align-center gap-4">
                    <%= f.check_box :event_1_attending, class:"accent-secondary-dark w-8 h-8" %>
                    <span class="font-bold">Welcome Dinner</span> on Friday the 16th
                </label>

                <label class="flex align-center gap-4">
                    <%= f.check_box :event_2_attending, class:"accent-secondary-dark w-8 h-8" %>
                    <span class="font-bold">Wedding Ceremony & Reception</span> on Saturday the 17th
                </label>

                <label class="flex align-center gap-4">
                    <%= f.check_box :event_3_attending, class:"accent-secondary-dark w-8 h-8" %>
                    <span class="font-bold">Farewell Dinner</span> Sunday the 17th
                </label>
            </div>
        </div>

        <div class="mb-8">
            <h5 class="font-eddie font-normal mb-3">Any dietary requirements?</h5>
            <%= f.text_area :dietary_requirements, rows:4, class:"border border-3 text-3xl p-4 w-full" %>
        </div>

        <div class="mb-8">
            <h5 class="font-eddie font-normal mb-3">Anything else you would like us to know?</h5>
            <%= f.text_area :notes, rows:4, class:"border border-3 text-3xl p-4 w-full" %>
        </div>
        
        <div>
            <%= f.submit "Submit RSVP" %>
        </div>
    <% end %>
</div>
<%= render "shared/footer" %>